diff --git a/ports/webassembly/main.c b/ports/webassembly/main.c
index 670d404da..0f93bace3 100644
--- a/ports/webassembly/main.c
+++ b/ports/webassembly/main.c
@@ -52,7 +52,9 @@ static size_t external_call_depth = 0;
 #endif
 
 // Emscripten defaults to a 64k C-stack, so our limit should be less than that.
+#ifndef CSTACK_SIZE
 #define CSTACK_SIZE (32 * 1024)
+#endif
 
 #if MICROPY_GC_SPLIT_HEAP_AUTO
 static void gc_collect_top_level(mp_obj_t root_obj);
@@ -77,12 +79,28 @@ void mp_js_init(int pystack_size, int heap_size) {
     mp_cstack_init_with_sp_here(CSTACK_SIZE);
 
     #if MICROPY_ENABLE_PYSTACK
+    #if MICROPY_PICOBOY_EMU
+    // Jeder Testlauf ist ein echter Neustart wie Strg-D am Geraet: derselbe
+    // Speicher wird neu aufgesetzt, statt jedes Mal neuen zu holen.
+    static mp_obj_t *pystack = NULL;
+    if (pystack == NULL) {
+        pystack = (mp_obj_t *)malloc(pystack_size * sizeof(mp_obj_t));
+    }
+    #else
     mp_obj_t *pystack = (mp_obj_t *)malloc(pystack_size * sizeof(mp_obj_t));
+    #endif
     mp_pystack_init(pystack, pystack + pystack_size);
     #endif
 
     #if MICROPY_ENABLE_GC
+    #if MICROPY_PICOBOY_EMU
+    static char *heap = NULL;
+    if (heap == NULL) {
+        heap = (char *)malloc(heap_size * sizeof(char));
+    }
+    #else
     char *heap = (char *)malloc(heap_size * sizeof(char));
+    #endif
     gc_init(heap, heap + heap_size);
     #endif
 
@@ -96,6 +114,10 @@ void mp_js_init(int pystack_size, int heap_size) {
 
     mp_init();
 
+    #if MICROPY_PICOBOY_EMU
+    pb_nach_init();
+    #endif
+
     #if MICROPY_VFS_POSIX
     {
         // Mount the host FS at the root of our internal VFS
@@ -216,7 +238,9 @@ static void gc_scan_func(void *begin, void *end) {
 void gc_collect(void) {
     gc_collect_start();
     emscripten_scan_stack(gc_scan_func);
+    #if !MICROPY_PICOBOY_EMU
     emscripten_scan_registers(gc_scan_func);
+    #endif
     gc_collect_end();
 }
 
